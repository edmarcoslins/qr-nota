<?xml version="1.0" encoding="utf-8"?>
<!-- Página "Enviar NF": leitor, armazenamento local e envio para Google Planilha -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pageSend"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="24dp">

        <!-- 1. Leitor de QR Code -->
        <LinearLayout
            style="@style/Card"
            android:gravity="center_horizontal">

            <TextView
                style="@style/SectionTitle"
                android:text="Leitor de QR Code da nota fiscal" />

            <TextView
                style="@style/Body"
                android:text="Toque no botão e aponte a câmera para o QR code impresso na nota." />

            <FrameLayout
                android:id="@+id/btnScan"
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_scan"
                android:clickable="true"
                android:contentDescription="Ler QR da nota"
                android:elevation="10dp"
                android:focusable="true">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_qr" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="Ler QR da nota"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <CheckBox
                android:id="@+id/chkIr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/primary"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:text="Imposto de Renda"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <!-- Resultado da última leitura -->
            <LinearLayout
                android:id="@+id/cardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_status"
                android:orientation="horizontal"
                android:padding="18dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_dot" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtStatusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:autoLink="web"
                        android:textColor="@color/text_muted"
                        android:textColorLink="@color/primary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Armazenamento local (sempre ativo) -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="Armazenamento local" />

            <TextView
                style="@style/Body"
                android:text="Sempre ativo: toda nota lida fica salva no celular, mesmo sem internet." />

            <TextView
                android:id="@+id/txtNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnGoManage"
                style="@style/ButtonOutline"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Ver, apagar ou compartilhar notas" />
        </LinearLayout>

        <!-- 3. Envio para Google Planilha (opcional) -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="Envio para Google Planilha" />

            <TextView
                style="@style/Body"
                android:text="Opcional: envia cada nota também para uma planilha sua no Google. Mesmo se o envio falhar, a nota continua salva no celular." />

            <CheckBox
                android:id="@+id/chkSheets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:buttonTint="@color/primary"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="6dp"
                android:text="Ativar envio para Google Planilha"
                android:textColor="@color/text"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/sheetsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/btnGoTutorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Não sabe configurar? Veja o passo a passo  ›"
                    android:textColor="@color/primary"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Label"
                    android:layout_marginTop="8dp"
                    android:text="URL do Apps Script" />

                <EditText
                    android:id="@+id/edtUrl"
                    style="@style/Input"
                    android:hint="https://script.google.com/…/exec"
                    android:inputType="textUri" />

                <TextView
                    style="@style/Label"
                    android:text="Token (senha do script)" />

                <EditText
                    android:id="@+id/edtToken"
                    style="@style/Input"
                    android:hint="Seu token secreto"
                    android:inputType="textVisiblePassword" />

                <TextView
                    style="@style/Body"
                    android:layout_marginTop="6dp"
                    android:text="Gerado automaticamente. O script baixado no tutorial já vem com este token."
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnSave"
                    style="@style/ButtonFilled"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Salvar configuração"
                    android:textSize="16sp" />

                <!-- Fila de envio à planilha -->
                <TextView
                    android:id="@+id/txtPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/pendingActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRetry"
                        style="@style/ButtonOutline"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="Reenviar" />

                    <Button
                        android:id="@+id/btnClear"
                        style="@style/ButtonOutline.Danger"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Limpar fila" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
