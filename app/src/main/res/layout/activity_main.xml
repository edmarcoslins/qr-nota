<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Conteúdo: cabeçalho + página atual -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Abrir menu"
                android:src="@drawable/ic_menu" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPageTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_primary"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/txtPageSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:textColor="@color/on_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/page_send" />

            <include layout="@layout/page_manage" />

            <include layout="@layout/page_tutorial" />

            <include layout="@layout/page_about" />
        </FrameLayout>
    </LinearLayout>

    <!-- Menu lateral -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/card"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_header_flat"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/on_primary"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.85"
                android:text="Suas notas fiscais na palma da mão"
                android:textColor="@color/on_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/navSend"
            style="@style/MenuItem"
            android:drawableStart="@drawable/ic_qr"
            android:text="Enviar NF" />

        <TextView
            android:id="@+id/navManage"
            style="@style/MenuItem"
            android:drawableStart="@drawable/ic_list"
            android:text="Gerir NF" />

        <TextView
            android:id="@+id/navTutorial"
            style="@style/MenuItem"
            android:drawableStart="@drawable/ic_help"
            android:text="Tutorial google planilha" />

        <TextView
            android:id="@+id/navAbout"
            style="@style/MenuItem"
            android:drawableStart="@drawable/ic_info"
            android:text="Sobre" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
